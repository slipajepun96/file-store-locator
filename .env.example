# Copy this file to .env and fill it in (or set these in your cloud host's dashboard).

# --- Google sign-in (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This Google account becomes admin automatically on its first sign-in.
ADMIN_EMAIL=

# Public address of the app, used for the Google redirect URL. Optional: defaults to the address in the browser.
# APP_URL=https://files.example.com

# --- Fallback username/password admin ---
# Only created when ADMIN_EMAIL is NOT set and no admin exists yet.
# If ADMIN_PASSWORD is empty, a temporary password is printed in the server log.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- MySQL ---
# Either one connection URL (many cloud hosts provide this)...
# DATABASE_URL=mysql://user:password@host:3306/file_store_locator
# ...or the separate settings. The database must exist; the tables are created on start.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=file_store_locator

# --- Server ---
# PORT=3001
# COOKIE_SECURE=true
