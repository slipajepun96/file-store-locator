{
  "id": "/",
  "name": "File Store Locator",
  "short_name": "Files",
  "description": "Find where files are stored, and record and route letters between departments.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
